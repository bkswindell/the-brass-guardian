---
import SiteLayout from "./SiteLayout.astro";

interface Props {
  title: string;
  description: string;
  section?: string;
}

const {
  title,
  description,
  section = "Public Cartography Division",
} = Astro.props;
---

<SiteLayout title={`${title} — The Brass Guardian`} description={description} noindex>
  <div class="archive-atmosphere" aria-hidden="true">
    <span class="archive-glow"></span>
    <span class="archive-grid"></span>
  </div>

  <a class="skip-link" href="#archive-content">Skip to archive content</a>

  <header class="archive-header">
    <a class="archive-brand" href="/archive/" aria-label="Aetherhaven Archives home">
      <span class="archive-monogram" aria-hidden="true">AH</span>
      <span>
        <strong>Aetherhaven Archives</strong>
        <small>{section}</small>
      </span>
    </a>

    <nav aria-label="Archive navigation">
      <a href="/archive/">Entrance</a>
      <a href="/archive/#curators-route">Curator’s Route</a>
      <a href="/archive/map/">Map Room</a>
      <a href="/archive/#open-catalog">Open Catalog</a>
      <a href="/">Main exhibit</a>
    </nav>
  </header>

  <main id="archive-content" class="archive-main">
    <slot />
  </main>

  <footer class="archive-footer">
    <span>Aetherhaven Archives</span>
    <span>Proposal preview • Not canonical publication</span>
  </footer>
</SiteLayout>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: Georgia, "Times New Roman", serif;
    background: #050b13;
    color: #f3e3bb;
    --archive-ink: #f3e3bb;
    --archive-muted: #a9c6cf;
    --archive-paper: #d7c18d;
    --archive-brass: #c58a36;
    --archive-copper: #8f4f2e;
    --archive-blue: #65c7e4;
    --archive-deep: #050b13;
    --archive-panel: rgb(8 23 35 / 92%);
    --archive-line: rgb(197 138 54 / 42%);
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-width: 20rem;
    background: var(--archive-deep);
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    margin: 0;
    overflow-x: hidden;
    background:
      radial-gradient(circle at 52% 12%, rgb(32 118 145 / 24%), transparent 34rem),
      linear-gradient(160deg, #030811 0%, #071421 52%, #040a12 100%);
  }

  body::before {
    position: fixed;
    z-index: -3;
    inset: 0;
    background-image:
      linear-gradient(rgb(133 205 225 / 2.6%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(133 205 225 / 2.6%) 1px, transparent 1px);
    background-size: 4rem 4rem;
    content: "";
    mask-image: linear-gradient(to bottom, #000, transparent 80%);
  }

  a {
    color: inherit;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  :focus-visible {
    outline: 3px solid var(--archive-blue);
    outline-offset: 4px;
  }

  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.7rem 1rem;
    color: #06101a;
    background: #bfe9f4;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .archive-atmosphere {
    position: fixed;
    z-index: -2;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .archive-glow {
    position: absolute;
    top: -18rem;
    left: 50%;
    width: min(86vw, 66rem);
    aspect-ratio: 1;
    border: 1px solid rgb(101 199 228 / 10%);
    border-radius: 50%;
    box-shadow: 0 0 11rem rgb(49 164 199 / 11%);
    transform: translateX(-50%);
  }

  .archive-grid {
    position: absolute;
    right: 0;
    bottom: 10%;
    left: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--archive-line), transparent);
  }

  .archive-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100% - 2rem, 88rem);
    margin: 0 auto;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--archive-line);
    gap: 1.5rem;
  }

  .archive-brand {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    text-decoration: none;
    gap: 0.8rem;
  }

  .archive-brand strong,
  .archive-brand small {
    display: block;
  }

  .archive-brand strong {
    font-size: clamp(0.9rem, 1.7vw, 1.1rem);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .archive-brand small {
    margin-top: 0.25rem;
    color: var(--archive-muted);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .archive-monogram {
    display: grid;
    flex: 0 0 auto;
    width: 2.65rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--archive-brass);
    border-radius: 50%;
    color: var(--archive-paper);
    box-shadow: inset 0 0 0 4px rgb(197 138 54 / 8%);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
  }

  .archive-header nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .archive-header nav a {
    padding: 0.55rem 0.72rem;
    border: 1px solid transparent;
    color: var(--archive-muted);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .archive-header nav a:hover {
    border-color: var(--archive-line);
    color: var(--archive-ink);
    background: rgb(197 138 54 / 7%);
  }

  .archive-main {
    width: min(100% - 2rem, 88rem);
    min-height: calc(100vh - 11rem);
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 5rem) 0;
  }

  .archive-footer {
    display: flex;
    justify-content: space-between;
    width: min(100% - 2rem, 88rem);
    margin: 0 auto;
    padding: 1.25rem 0 1.6rem;
    border-top: 1px solid var(--archive-line);
    color: #799aa6;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    gap: 1rem;
  }

  .archive-kicker {
    margin: 0 0 0.7rem;
    color: var(--archive-brass);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  .archive-title {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.6rem, 8vw, 6.6rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.92;
    text-wrap: balance;
  }

  .archive-lede {
    max-width: 44rem;
    margin: 1.5rem 0 0;
    color: #c7dce1;
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.75;
  }

  .proposal-notice {
    display: flex;
    align-items: flex-start;
    margin: 0 0 2rem;
    padding: 0.85rem 1rem;
    border: 1px solid rgb(101 199 228 / 34%);
    background: rgb(22 79 98 / 17%);
    color: #bfe4ed;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    line-height: 1.5;
    gap: 0.65rem;
  }

  .proposal-notice strong {
    color: #e1f5fa;
  }

  .proposal-dot {
    flex: 0 0 auto;
    width: 0.55rem;
    height: 0.55rem;
    margin-top: 0.3rem;
    border-radius: 50%;
    background: var(--archive-blue);
    box-shadow: 0 0 1rem rgb(101 199 228 / 65%);
  }

  .archive-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.8rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--archive-brass);
    color: var(--archive-ink);
    background: linear-gradient(135deg, rgb(197 138 54 / 20%), rgb(101 199 228 / 7%));
    font: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.09em;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }

  .archive-button:hover {
    background: linear-gradient(135deg, rgb(197 138 54 / 32%), rgb(101 199 228 / 11%));
  }

  @media (max-width: 44rem) {
    .archive-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.8rem;
    }

    .archive-header nav {
      justify-content: flex-start;
      width: 100%;
    }

    .archive-header nav a:first-child {
      padding-left: 0;
    }

    .archive-footer {
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
