---
import SiteLayout from "./SiteLayout.astro";
import { getWorldEntrancePreview } from "../lib/archive-preview.mjs";

interface Props {
  title: string;
  description: string;
  section?: string;
}

const {
  title,
  description,
  section = "Public Cartography Division",
} = Astro.props;
const archive = getWorldEntrancePreview();
---

<SiteLayout title={`${title} — The Brass Guardian`} description={description} noindex>
  <div class:list={["archive-shell", { "archive-shell-open": archive.enabled }]}>
    {
      archive.enabled && (
        <picture class="archive-interior-scene" aria-hidden="true">
          <source
            srcset="/images/archive/aetherhaven-archive-threshold-768.webp 768w, /images/archive/aetherhaven-archive-threshold-1024.webp 1024w"
            sizes="100vw"
            type="image/webp"
          />
          <img
            src="/images/archive/aetherhaven-archive-threshold-1024.webp"
            alt=""
            width="1024"
            height="576"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
      )
    }

    <div class="archive-atmosphere" aria-hidden="true">
      <span class="archive-glow"></span>
      <span class="archive-grid"></span>
    </div>
    <div class="archive-room-floor" aria-hidden="true"></div>

    <a class="skip-link" href="#archive-content">Skip to archive content</a>

    <header class="archive-header">
      <a class="archive-brand" href="/archive/" aria-label="Aetherhaven Archives home">
        <span class="archive-monogram" aria-hidden="true">AH</span>
        <span>
          <strong>Aetherhaven Archives</strong>
          <small>{section}</small>
        </span>
      </a>

      <nav aria-label="Archive navigation">
        <a href="/archive/">Entrance</a>
        <a href="/archive/#curators-route">Curator’s Route</a>
        <a href="/archive/map/">Map Room</a>
        <a href="/archive/#open-catalog">Open Catalog</a>
        <a href="/">Main exhibit</a>
      </nav>
    </header>

    <main id="archive-content" class="archive-main">
      <slot />
    </main>

    <footer class="archive-footer">
      <span>Aetherhaven Archives</span>
      <span>Proposal preview • Not canonical publication</span>
    </footer>
  </div>
</SiteLayout>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: Georgia, "Times New Roman", serif;
    background: #050b13;
    color: #f3e3bb;
    --archive-ink: #f3e3bb;
    --archive-muted: #a9c6cf;
    --archive-paper: #d7c18d;
    --archive-brass: #c58a36;
    --archive-copper: #8f4f2e;
    --archive-blue: #65c7e4;
    --archive-deep: #050b13;
    --archive-panel: rgb(8 23 35 / 80%);
    --archive-line: rgb(197 138 54 / 42%);
    --archive-glass: rgb(4 16 25 / 68%);
    --archive-wood: rgb(31 22 15 / 84%);
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-width: 20rem;
    background: var(--archive-deep);
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    margin: 0;
    overflow-x: hidden;
    background: linear-gradient(160deg, #030811 0%, #071421 52%, #040a12 100%);
  }

  .archive-shell {
    position: relative;
    min-height: 100vh;
    isolation: isolate;
  }

  .archive-interior-scene,
  .archive-interior-scene img {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .archive-interior-scene {
    z-index: -4;
    overflow: hidden;
    background: #030911;
    opacity: 0.82;
    pointer-events: none;
  }

  .archive-interior-scene img {
    object-fit: cover;
    object-position: center 40%;
    filter: saturate(0.82) contrast(0.96) brightness(0.64);
    transform: scale(1.025);
  }

  .archive-shell-open::before {
    position: fixed;
    z-index: -3;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(2 7 12 / 42%), transparent 24%, transparent 76%, rgb(2 7 12 / 42%)),
      radial-gradient(circle at 50% 35%, transparent 0 24%, rgb(2 8 14 / 22%) 66%, rgb(2 7 12 / 58%) 100%),
      linear-gradient(180deg, rgb(2 8 14 / 8%), rgb(3 10 17 / 22%) 58%, rgb(3 9 15 / 72%) 100%);
    content: "";
    pointer-events: none;
  }

  a {
    color: inherit;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  :focus-visible {
    outline: 3px solid var(--archive-blue);
    outline-offset: 4px;
  }

  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.7rem 1rem;
    color: #06101a;
    background: #bfe9f4;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .archive-atmosphere {
    position: fixed;
    z-index: -1;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .archive-glow {
    position: absolute;
    top: -18rem;
    left: 50%;
    width: min(86vw, 66rem);
    aspect-ratio: 1;
    border: 1px solid rgb(101 199 228 / 7%);
    border-radius: 50%;
    box-shadow: 0 0 11rem rgb(49 164 199 / 8%);
    transform: translateX(-50%);
  }

  .archive-grid {
    position: absolute;
    right: 0;
    bottom: 10%;
    left: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(197 138 54 / 22%), transparent);
  }

  .archive-room-floor {
    position: fixed;
    z-index: -2;
    right: -8vw;
    bottom: -35vh;
    left: -8vw;
    height: 68vh;
    background:
      linear-gradient(180deg, transparent, rgb(2 7 12 / 44%) 28%, rgb(2 7 12 / 86%)),
      repeating-linear-gradient(94deg, rgb(142 91 39 / 7%) 0 1px, transparent 1px 8vw);
    opacity: 0.8;
    pointer-events: none;
  }

  .archive-header {
    position: sticky;
    z-index: 20;
    top: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100% - 2rem, 92rem);
    margin: 0.75rem auto 0;
    padding: 0.85rem 1rem;
    border: 1px solid var(--archive-line);
    background: rgb(3 13 21 / 86%);
    box-shadow:
      0 1rem 3rem rgb(0 0 0 / 22%),
      inset 0 1px rgb(219 175 101 / 7%);
    gap: 1.5rem;
  }

  .archive-shell-open .archive-header {
    background:
      linear-gradient(90deg, rgb(197 138 54 / 7%), transparent 22%, transparent 78%, rgb(101 199 228 / 5%)),
      var(--archive-glass);
    backdrop-filter: blur(14px) saturate(0.84);
  }

  .archive-brand {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    text-decoration: none;
    gap: 0.8rem;
  }

  .archive-brand strong,
  .archive-brand small {
    display: block;
  }

  .archive-brand strong {
    font-size: clamp(0.9rem, 1.7vw, 1.1rem);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .archive-brand small {
    margin-top: 0.25rem;
    color: var(--archive-muted);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .archive-monogram {
    display: grid;
    flex: 0 0 auto;
    width: 2.65rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--archive-brass);
    border-radius: 50%;
    color: var(--archive-paper);
    box-shadow: inset 0 0 0 4px rgb(197 138 54 / 8%);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
  }

  .archive-header nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .archive-header nav a {
    padding: 0.55rem 0.72rem;
    border: 1px solid transparent;
    color: var(--archive-muted);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .archive-header nav a:hover {
    border-color: var(--archive-line);
    color: var(--archive-ink);
    background: rgb(197 138 54 / 7%);
  }

  .archive-main {
    position: relative;
    z-index: 2;
    width: min(100% - 2rem, 88rem);
    min-height: calc(100vh - 11rem);
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 5rem) 0;
  }

  .archive-footer {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    width: min(100% - 2rem, 88rem);
    margin: 0 auto;
    padding: 1.25rem 1rem 1.6rem;
    border: 1px solid var(--archive-line);
    background: rgb(3 13 21 / 72%);
    backdrop-filter: blur(12px);
    color: #799aa6;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    gap: 1rem;
  }

  .archive-kicker {
    margin: 0 0 0.7rem;
    color: var(--archive-brass);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  .archive-title {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.6rem, 8vw, 6.6rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.92;
    text-wrap: balance;
  }

  .archive-lede {
    max-width: 44rem;
    margin: 1.5rem 0 0;
    color: #c7dce1;
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.75;
  }

  .proposal-notice {
    display: flex;
    align-items: flex-start;
    width: fit-content;
    max-width: min(100%, 58rem);
    margin: 0 0 2rem auto;
    padding: 0.85rem 1rem;
    border: 1px solid rgb(101 199 228 / 34%);
    background: rgb(4 26 37 / 72%);
    box-shadow: 0 0.8rem 2.5rem rgb(0 0 0 / 16%);
    backdrop-filter: blur(10px);
    color: #bfe4ed;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    line-height: 1.5;
    gap: 0.65rem;
  }

  .proposal-notice strong {
    color: #e1f5fa;
  }

  .proposal-dot {
    flex: 0 0 auto;
    width: 0.55rem;
    height: 0.55rem;
    margin-top: 0.3rem;
    border-radius: 50%;
    background: var(--archive-blue);
    box-shadow: 0 0 1rem rgb(101 199 228 / 65%);
  }

  .archive-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.8rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--archive-brass);
    color: var(--archive-ink);
    background: linear-gradient(135deg, rgb(197 138 54 / 20%), rgb(101 199 228 / 7%));
    font: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.09em;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }

  .archive-button:hover {
    background: linear-gradient(135deg, rgb(197 138 54 / 32%), rgb(101 199 228 / 11%));
  }

  @media (max-width: 44rem) {
    .archive-header {
      position: relative;
      top: auto;
      align-items: flex-start;
      flex-direction: column;
      gap: 0.8rem;
    }

    .archive-header nav {
      justify-content: flex-start;
      width: 100%;
    }

    .archive-header nav a:first-child {
      padding-left: 0;
    }

    .archive-footer {
      flex-direction: column;
    }

    .archive-interior-scene {
      opacity: 0.68;
    }

    .archive-interior-scene img {
      object-position: 48% center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }

    .archive-interior-scene img {
      transform: none;
    }
  }
</style>
