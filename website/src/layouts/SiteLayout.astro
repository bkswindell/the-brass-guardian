---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import SiteMeta from "../components/SiteMeta.astro";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  noindex = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteMeta
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
    />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
