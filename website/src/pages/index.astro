---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import SiteMeta from "../components/SiteMeta.astro";

const pageTitle = "The Brass Guardian — Coming Soon";
const pageDescription =
  "The Aetherhaven Archives are being prepared for public access.";
const canonicalUrl = "https://thebrassguardian.com/";
---

<!doctype html>
<html lang="en">
  <head>
    <SiteMeta
      title={pageTitle}
      description={pageDescription}
      canonical={canonicalUrl}
    />
  </head>
  <body>
    <div class="atmosphere" aria-hidden="true">
      <span class="aether-glow"></span>
      <span class="horizon"></span>
    </div>

    <main aria-labelledby="site-title">
      <section class="archive-card">
        <p class="catalog-line">
          <span>Aetherhaven Archives</span>
          <span aria-hidden="true">•</span>
          <span>Public Access</span>
        </p>

        <div class="card-grid">
          <div class="message">
            <div class="archive-mark" aria-hidden="true">
              <span>AH</span>
            </div>

            <p class="status">Archive preparations underway</p>
            <h1 id="site-title">The Brass Guardian</h1>
            <p class="coming-soon">Coming Soon</p>
            <p class="summary">{pageDescription}</p>

            <div class="ornament" aria-hidden="true">
              <span></span>
              <i></i>
              <span></span>
            </div>

            <p class="return">Return soon.</p>
          </div>

          <figure class="cover-display">
            <button
              id="cover-open"
              class="cover-trigger"
              type="button"
              aria-haspopup="dialog"
              aria-controls="cover-reader"
              aria-label="Open The Brass Guardian cover in the archive reader"
            >
              <picture>
                <source
                  srcset="/images/the-brass-guardian-cover-480.webp 480w, /images/the-brass-guardian-cover-767.webp 767w"
                  sizes="(max-width: 56rem) min(82vw, 24rem), 23rem"
                  type="image/webp"
                />
                <img
                  src="/images/the-brass-guardian-cover-767.webp"
                  alt="Cover artwork showing Elias and Amelia Hawthorne overlooking the brass-lit city of Aetherhaven."
                  width="767"
                  height="1151"
                  decoding="async"
                  fetchpriority="high"
                />
              </picture>
              <span class="zoom-cue" aria-hidden="true">Open cover</span>
            </button>

            <div class="book-stand" aria-hidden="true">
              <span class="stand-cradle"></span>
              <span class="stand-stem"></span>
              <span class="stand-base"></span>
            </div>

            <figcaption>
              Archive display
              <span>Open cover viewer</span>
            </figcaption>
          </figure>
        </div>
      </section>
    </main>

    <footer class="site-footer">thebrassguardian.com</footer>

    <dialog
      id="cover-reader"
      class="cover-reader"
      aria-labelledby="reader-title"
    >
      <div class="reader-shell">
        <header class="reader-header">
          <div>
            <p>Aetherhaven Archive Reader</p>
            <h2 id="reader-title">The Brass Guardian</h2>
          </div>
          <button id="cover-close" type="button" aria-label="Close cover viewer">
            <span>Close</span>
            <b aria-hidden="true">×</b>
          </button>
        </header>

        <div class="reader-stage">
          <img
            src="/images/the-brass-guardian-cover-767.webp"
            alt="Cover artwork showing Elias and Amelia Hawthorne overlooking the brass-lit city of Aetherhaven."
            width="767"
            height="1151"
          />
        </div>

        <footer class="reader-footer">
          <span>Cover • 1 of 1</span>
          <span>Press Esc to close</span>
        </footer>
      </div>
    </dialog>

    <Analytics />
    <SpeedInsights />

    <script>
      const openButton = document.querySelector<HTMLButtonElement>("#cover-open");
      const closeButton = document.querySelector<HTMLButtonElement>("#cover-close");
      const reader = document.querySelector<HTMLDialogElement>("#cover-reader");

      const closeReader = () => reader?.close();

      openButton?.addEventListener("click", () => {
        reader?.showModal();
        document.documentElement.classList.add("reader-open");
      });

      closeButton?.addEventListener("click", closeReader);

      reader?.addEventListener("click", (event) => {
        if (event.target === reader) closeReader();
      });

      reader?.addEventListener("close", () => {
        document.documentElement.classList.remove("reader-open");
        openButton?.focus();
      });
    </script>
  </body>
</html>

<style>
  :global(:root) {
    color-scheme: dark;
    font-family: Georgia, "Times New Roman", serif;
    background: #050c16;
    color: #f3e3bb;
  }

  :global(body) {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    margin: 0;
    overflow-x: hidden;
    background:
      radial-gradient(circle at 50% 38%, rgb(16 76 100 / 38%), transparent 36rem),
      linear-gradient(155deg, #030914 0%, #09182a 52%, #06101d 100%);
    isolation: isolate;
  }

  :global(html.reader-open),
  :global(html.reader-open body) {
    overflow: hidden;
  }

  .atmosphere {
    position: fixed;
    z-index: -1;
    inset: 0;
    pointer-events: none;
  }

  .atmosphere::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(150 218 238 / 3%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(150 218 238 / 3%) 1px, transparent 1px);
    background-size: 4rem 4rem;
    content: "";
    mask-image: linear-gradient(to bottom, transparent, #000 30%, transparent);
  }

  .aether-glow {
    position: absolute;
    top: 20%;
    left: 50%;
    width: min(70vw, 44rem);
    aspect-ratio: 1;
    border: 1px solid rgb(123 218 244 / 15%);
    border-radius: 50%;
    box-shadow:
      0 0 7rem rgb(50 196 233 / 13%),
      inset 0 0 7rem rgb(50 196 233 / 8%);
    transform: translate(-50%, -50%);
  }

  .horizon {
    position: absolute;
    right: 0;
    bottom: 8%;
    left: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(180 126 58 / 28%), transparent);
  }

  main {
    display: grid;
    flex: 1;
    width: min(100% - 2rem, 76rem);
    margin-inline: auto;
    padding-block: clamp(2rem, 8vh, 6rem);
    place-items: center;
  }

  .archive-card {
    position: relative;
    width: min(100%, 74rem);
    box-sizing: border-box;
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid rgb(182 126 58 / 50%);
    background:
      linear-gradient(135deg, rgb(187 132 65 / 8%), transparent 38%),
      rgb(4 13 24 / 88%);
    box-shadow:
      0 2rem 6rem rgb(0 0 0 / 48%),
      inset 0 0 0 0.25rem rgb(3 12 22 / 75%),
      inset 0 0 0 0.3rem rgb(182 126 58 / 20%);
    text-align: center;
    backdrop-filter: blur(0.75rem);
  }

  .archive-card::before,
  .archive-card::after {
    position: absolute;
    width: 2rem;
    height: 2rem;
    border-color: #b67e3a;
    content: "";
  }

  .archive-card::before {
    top: 0.75rem;
    left: 0.75rem;
    border-top: 1px solid;
    border-left: 1px solid;
  }

  .archive-card::after {
    right: 0.75rem;
    bottom: 0.75rem;
    border-right: 1px solid;
    border-bottom: 1px solid;
  }

  .catalog-line,
  .status,
  .return,
  .site-footer {
    font-family: system-ui, sans-serif;
    text-transform: uppercase;
  }

  .catalog-line {
    display: flex;
    justify-content: center;
    margin: 0 0 2rem;
    color: #bd9b67;
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.18em;
    gap: 0.65rem;
  }

  .card-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 23rem);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  .message {
    min-width: 0;
  }

  .archive-mark {
    display: grid;
    width: 4rem;
    aspect-ratio: 1;
    margin: 0 auto 1.75rem;
    border: 1px solid #b67e3a;
    border-radius: 50%;
    color: #e4c188;
    box-shadow:
      0 0 0 0.35rem rgb(4 13 24),
      0 0 0 0.4rem rgb(182 126 58 / 45%);
    font-size: 0.9rem;
    letter-spacing: 0.14em;
    place-items: center;
  }

  .archive-mark span {
    transform: translateX(0.08em);
  }

  .status {
    margin: 0 0 0.9rem;
    color: #79d2eb;
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.22em;
  }

  h1 {
    margin: 0;
    color: #f2dfb2;
    font-size: clamp(2.6rem, 7vw, 5.2rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.95;
    text-wrap: balance;
    text-shadow: 0 0 2.5rem rgb(238 185 103 / 14%);
  }

  .coming-soon {
    margin: 1.25rem 0 2rem;
    color: #c9954e;
    font-size: clamp(1rem, 3vw, 1.35rem);
    font-style: italic;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .summary {
    max-width: 31rem;
    margin: 0 auto;
    color: #b9d8df;
    font-family: system-ui, sans-serif;
    font-size: clamp(1rem, 2.5vw, 1.15rem);
    line-height: 1.75;
    text-wrap: balance;
  }

  .ornament {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: min(100%, 18rem);
    margin: 2.25rem auto 1.75rem;
    gap: 0.8rem;
  }

  .ornament span {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(182 126 58 / 72%));
  }

  .ornament span:last-child {
    transform: rotate(180deg);
  }

  .ornament i {
    width: 0.45rem;
    aspect-ratio: 1;
    border: 1px solid #b67e3a;
    transform: rotate(45deg);
  }

  .return {
    margin: 0;
    color: #8fabc0;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
  }

  .cover-display {
    display: grid;
    justify-items: center;
    margin: 0;
  }

  .cover-trigger {
    position: relative;
    width: 100%;
    margin: 0;
    padding: 0.4rem;
    border: 1px solid rgb(182 126 58 / 72%);
    background: #07101b;
    color: inherit;
    box-shadow:
      0 1.5rem 3.5rem rgb(0 0 0 / 55%),
      0 0 2.5rem rgb(61 177 207 / 10%),
      inset 0 0 0 0.2rem rgb(224 184 117 / 7%);
    cursor: zoom-in;
    transform: rotate(0.45deg);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
    touch-action: manipulation;
  }

  .cover-trigger::after {
    position: absolute;
    z-index: -1;
    inset: 0.8rem -0.6rem -0.8rem 0.6rem;
    border: 1px solid rgb(95 190 216 / 18%);
    content: "";
  }

  .cover-trigger:hover {
    border-color: #e0b46f;
    box-shadow:
      0 1.9rem 4rem rgb(0 0 0 / 62%),
      0 0 3.5rem rgb(61 177 207 / 17%);
    transform: translateY(-0.3rem) rotate(0.25deg);
  }

  .cover-trigger:focus-visible {
    outline: 3px solid #79d2eb;
    outline-offset: 0.45rem;
  }

  .cover-trigger picture,
  .cover-trigger img {
    display: block;
    width: 100%;
  }

  .cover-trigger img {
    height: auto;
    aspect-ratio: 767 / 1151;
  }

  .zoom-cue {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid rgb(222 181 112 / 62%);
    background: rgb(3 10 18 / 90%);
    color: #f2dfb2;
    font-family: system-ui, sans-serif;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .book-stand {
    position: relative;
    display: grid;
    justify-items: center;
    width: 86%;
    height: 3.4rem;
    margin-top: -0.1rem;
  }

  .book-stand span {
    position: absolute;
    display: block;
    background: linear-gradient(180deg, #d1a35f, #744316 65%, #3f240e);
    box-shadow: 0 0.65rem 1.2rem rgb(0 0 0 / 48%);
  }

  .stand-cradle {
    top: 0;
    width: 100%;
    height: 0.65rem;
    border: 1px solid #d2a45d;
    clip-path: polygon(2% 0, 98% 0, 92% 100%, 8% 100%);
  }

  .stand-stem {
    top: 0.55rem;
    width: 1.15rem;
    height: 1.65rem;
    border-right: 1px solid #d2a45d;
    border-left: 1px solid #d2a45d;
  }

  .stand-base {
    bottom: 0.25rem;
    width: 72%;
    height: 0.65rem;
    border: 1px solid #d2a45d;
    clip-path: polygon(8% 0, 92% 0, 100% 100%, 0 100%);
  }

  .cover-display figcaption {
    display: flex;
    flex-direction: column;
    margin-top: 0.15rem;
    color: #9d7848;
    font-family: system-ui, sans-serif;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    line-height: 1.7;
    text-transform: uppercase;
  }

  .cover-display figcaption span {
    color: #7ebed0;
    font-size: 0.54rem;
  }

  .cover-reader {
    width: min(94vw, 78rem);
    max-width: none;
    height: 94dvh;
    max-height: none;
    box-sizing: border-box;
    padding: 0;
    overflow: hidden;
    border: 1px solid #9d6a30;
    background: #030a12;
    color: #f3e3bb;
    box-shadow: 0 2rem 8rem rgb(0 0 0 / 85%);
  }

  .cover-reader::backdrop {
    background: rgb(1 5 10 / 90%);
    backdrop-filter: blur(0.6rem);
  }

  .reader-shell {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    height: 100%;
  }

  .reader-header,
  .reader-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.1rem;
    border-color: rgb(182 126 58 / 35%);
    background: #07111d;
    font-family: system-ui, sans-serif;
  }

  .reader-header {
    border-bottom: 1px solid rgb(182 126 58 / 35%);
  }

  .reader-header p,
  .reader-header h2 {
    margin: 0;
  }

  .reader-header p {
    color: #79d2eb;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .reader-header h2 {
    margin-top: 0.15rem;
    color: #e8d4a6;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.1rem;
    font-weight: 500;
  }

  .reader-header button {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.5rem 0.4rem 0.75rem;
    border: 1px solid rgb(182 126 58 / 55%);
    background: #0b1825;
    color: #d8c295;
    font: inherit;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    gap: 0.65rem;
  }

  .reader-header button:hover,
  .reader-header button:focus-visible {
    border-color: #79d2eb;
    color: #fff0c5;
  }

  .reader-header button:focus-visible {
    outline: 2px solid #79d2eb;
    outline-offset: 0.2rem;
  }

  .reader-header b {
    font-size: 1.3rem;
    font-weight: 400;
    line-height: 0.8;
  }

  .reader-stage {
    display: grid;
    min-height: 0;
    overflow: auto;
    padding: clamp(0.75rem, 2vw, 1.5rem);
    background:
      radial-gradient(circle at center, rgb(24 86 108 / 28%), transparent 42rem),
      #020811;
    place-items: center;
  }

  .reader-stage img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: calc(94dvh - 7.5rem);
    border: 1px solid rgb(190 133 63 / 58%);
    box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 72%);
  }

  .reader-footer {
    border-top: 1px solid rgb(182 126 58 / 35%);
    color: #758ea2;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .site-footer {
    padding: 0 1rem 1.25rem;
    color: #577188;
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-align: center;
  }

  @media (max-width: 56rem) {
    .card-grid {
      grid-template-columns: 1fr;
    }

    .cover-display {
      width: min(82vw, 24rem);
      margin-inline: auto;
    }

    .cover-trigger {
      transform: none;
    }
  }

  @media (max-width: 32rem) {
    .catalog-line {
      flex-direction: column;
      gap: 0.4rem;
    }

    .catalog-line span:nth-child(2) {
      display: none;
    }

    .archive-card {
      box-shadow:
        0 1.5rem 4rem rgb(0 0 0 / 42%),
        inset 0 0 0 0.2rem rgb(3 12 22 / 75%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
    }

    .cover-trigger {
      transition: none;
    }
  }
</style>
