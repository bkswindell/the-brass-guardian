---
import ArchiveLayout from "../../layouts/ArchiveLayout.astro";
import { getWorldEntrancePreview } from "../../lib/archive-preview.mjs";

const archive = getWorldEntrancePreview();
const entries = archive.entries;
const curatorRoute = archive.curatorRoute;
const description =
  "Enter the proposal preview of the Aetherhaven Archives and explore the first cleared records through the city map.";

const entryHref = (entry) =>
  `/archive/${entry.entityType}/${entry.slug}/`;
---

<ArchiveLayout title="Explore Aetherhaven" description={description}>
  {
    archive.enabled ? (
      <>
        <aside class="proposal-notice" aria-label="Proposal preview notice">
          <span class="proposal-dot" aria-hidden="true"></span>
          <span>
            <strong>Proposal preview.</strong> This branch is a working exhibit. Its
            copy, classifications, and presentation are not canonical publication.
          </span>
        </aside>

        <section class="entrance-hero" aria-labelledby="archive-title">
          <div class="arrival-desk">
            <p class="archive-kicker">Public access corridor • Preview 01</p>
            <h1 id="archive-title" class="archive-title">Explore Aetherhaven</h1>
            <p class="archive-lede">
              A city of brass streets, living gardens, crowded workshops, and
              airship towers waits beyond the archive doors. The curators have
              arranged a path through the first cabinets—but every cleared drawer,
              map reference, and cross-link remains yours to follow.
            </p>
            <div class="hero-actions">
              <a class="archive-button" href={curatorRoute[0].href}>Begin curated route</a>
              <a class="text-link" href="#open-catalog">Open the catalog</a>
            </div>
          </div>

          <a class="map-window" href="/archive/map/" aria-label="Open the interactive Map of Aetherhaven">
            <picture>
              <source
                srcset="/images/archive/map-of-aetherhaven-768.webp 768w, /images/archive/map-of-aetherhaven-1152.webp 1152w"
                sizes="(max-width: 60rem) 94vw, 42vw"
                type="image/webp"
              />
              <img
                src="/images/archive/map-of-aetherhaven-1152.webp"
                alt="Preview of the illustrated Map of Aetherhaven."
                width="1152"
                height="862"
                decoding="async"
              />
            </picture>
            <span class="map-window-label">
              <small>Public Cartography Division</small>
              <strong>Map of Aetherhaven</strong>
              <em>Open map</em>
            </span>
          </a>
        </section>

        <section
          id="curators-route"
          class="discovery-section curator-section"
          aria-labelledby="curator-title"
        >
          <header class="section-heading">
            <div>
              <p class="archive-kicker">Suggested sequence • Eight stops</p>
              <h2 id="curator-title">The Curator’s Route</h2>
            </div>
            <p>
              A considered first passage through Aetherhaven. Follow it from end to
              end, leave it whenever another reference catches your eye, or return
              to it later without losing your place.
            </p>
          </header>

          <div class="route-layout">
            <aside class="curator-card">
              <p class="archive-kicker">From the curator’s desk</p>
              <blockquote>
                “Orientation is not restriction. We have placed the lamps; the doors
                between the cabinets remain open.”
              </blockquote>
              <p>
                The route moves from the city overview into the Map Room, through a
                living civic system, aboard an explorer’s vessel, and back into the
                working districts.
              </p>
            </aside>

            <ol class="route-list">
              {curatorRoute.map((step, index) => (
                <li>
                  <a href={step.href}>
                    <span class="route-number" aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <span class="route-copy">
                      <small>{step.label}</small>
                      <strong>{step.title}</strong>
                      <span>{step.note}</span>
                    </span>
                    <span class="route-arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </section>

        <section
          id="open-catalog"
          class="discovery-section catalog-section"
          aria-labelledby="catalog-title"
        >
          <header class="section-heading">
            <div>
              <p class="archive-kicker">Open drawers • Follow your own thread</p>
              <h2 id="catalog-title">Open Catalog</h2>
            </div>
            <p>
              7 records cleared for preview. Search by name or subject, narrow the
              cabinets by record class, or return to the map and choose by place.
            </p>
          </header>

          <div class="catalog-controls" aria-label="Catalog controls">
            <label for="catalog-search">
              <span>Search the catalog</span>
              <input
                id="catalog-search"
                type="search"
                placeholder="Place, vessel, subject…"
                autocomplete="off"
              />
            </label>
            <div class="catalog-filters" aria-label="Filter by record class">
              <button type="button" data-catalog-filter="all" aria-pressed="true">All records</button>
              <button type="button" data-catalog-filter="location" aria-pressed="false">Places</button>
              <button type="button" data-catalog-filter="district" aria-pressed="false">Districts</button>
              <button type="button" data-catalog-filter="vessel" aria-pressed="false">Vessels</button>
            </div>
            <output id="catalog-result-count" for="catalog-search" aria-live="polite">
              Showing {entries.length} of {entries.length} records
            </output>
          </div>

          <div class="record-grid">
            {entries.map((entry) => (
              <article
                class="record-card"
                data-catalog-card
                data-record-type={entry.entityType}
                data-record-search={`${entry.publicTitle} ${entry.tags.join(" ")}`.toLocaleLowerCase()}
              >
                <div class="record-code">
                  <span>{entry.mapMarker ? `Map ${entry.mapMarker}` : entry.entityType}</span>
                  <span>{entry.spoilerClassification}</span>
                </div>
                <h3>{entry.publicTitle}</h3>
                <p>{entry.publicSummary}</p>
                <a href={entryHref(entry)}>
                  Open catalog record <span aria-hidden="true">→</span>
                </a>
              </article>
            ))}
          </div>
          <p id="catalog-empty" class="catalog-empty" hidden>
            No cleared records match this inquiry. Try another term or open all drawers.
          </p>
        </section>

        <script>
          const search = document.querySelector<HTMLInputElement>("#catalog-search");
          const cards = [...document.querySelectorAll<HTMLElement>("[data-catalog-card]")];
          const filters = [...document.querySelectorAll<HTMLButtonElement>("[data-catalog-filter]")];
          const resultCount = document.querySelector<HTMLOutputElement>("#catalog-result-count");
          const empty = document.querySelector<HTMLElement>("#catalog-empty");
          let activeFilter = "all";

          const updateCatalog = () => {
            const query = search?.value.trim().toLocaleLowerCase() ?? "";
            let visible = 0;

            cards.forEach((card) => {
              const matchesType =
                activeFilter === "all" || card.dataset.recordType === activeFilter;
              const matchesQuery = card.dataset.recordSearch?.includes(query) ?? false;
              const show = matchesType && matchesQuery;
              card.hidden = !show;
              if (show) visible += 1;
            });

            if (resultCount) {
              resultCount.value = `Showing ${visible} of ${cards.length} records`;
            }
            if (empty) empty.hidden = visible !== 0;
          };

          search?.addEventListener("input", updateCatalog);
          search?.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && search.value) {
              search.value = "";
              updateCatalog();
            }
          });

          filters.forEach((filter) => {
            filter.addEventListener("click", () => {
              activeFilter = filter.dataset.catalogFilter ?? "all";
              filters.forEach((candidate) =>
                candidate.setAttribute(
                  "aria-pressed",
                  String(candidate === filter),
                ),
              );
              updateCatalog();
            });
          });
        </script>
      </>
    ) : (
      <section class="sealed-state" aria-labelledby="archive-title">
        <p class="archive-kicker">Public access pending</p>
        <h1 id="archive-title" class="archive-title">Archive sealed</h1>
        <p class="archive-lede">
          The World Entrance is available only in an authorized branch preview.
        </p>
        <a class="archive-button" href="/">Return to the main exhibit</a>
      </section>
    )
  }
</ArchiveLayout>

<style>
  .entrance-hero {
    position: relative;
    display: grid;
    align-items: end;
    grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 1.1fr);
    min-height: min(76vh, 52rem);
    padding: clamp(9rem, 22vh, 16rem) 0 clamp(2rem, 5vh, 4rem);
    gap: clamp(2rem, 6vw, 6rem);
  }

  .arrival-desk {
    position: relative;
    padding: clamp(1.5rem, 3.2vw, 2.6rem);
    border: 1px solid rgb(197 138 54 / 58%);
    background:
      linear-gradient(135deg, rgb(197 138 54 / 9%), transparent 42%),
      rgb(4 17 26 / 74%);
    box-shadow:
      0 1.8rem 5rem rgb(0 0 0 / 34%),
      inset 0 1px rgb(230 190 119 / 10%);
    backdrop-filter: blur(13px) saturate(0.82);
  }

  .arrival-desk::before {
    position: absolute;
    top: -0.38rem;
    left: 1.25rem;
    width: min(9rem, 42%);
    height: 0.38rem;
    background: linear-gradient(90deg, #7d4a1c, #d09a47 48%, #6e4019);
    content: "";
  }

  .arrival-desk .archive-title {
    max-width: 100%;
    font-size: clamp(3rem, 5vw, 5.5rem);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 2rem;
    gap: 1.1rem;
  }

  .text-link {
    color: var(--archive-muted);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-underline-offset: 0.25rem;
    text-transform: uppercase;
  }

  .map-window {
    position: relative;
    display: block;
    padding: clamp(0.55rem, 1.4vw, 0.9rem);
    border: 1px solid var(--archive-brass);
    color: var(--archive-ink);
    background: rgb(17 15 11 / 94%);
    box-shadow:
      0 2rem 5rem rgb(0 0 0 / 44%),
      0 0 4rem rgb(48 160 191 / 8%);
    text-decoration: none;
    transform: rotate(0.2deg);
    backdrop-filter: blur(8px);
  }

  .map-window::before,
  .map-window::after {
    position: absolute;
    z-index: 2;
    width: 1.2rem;
    height: 1.2rem;
    border-color: #ddaa53;
    content: "";
    pointer-events: none;
  }

  .map-window::before {
    top: 0.25rem;
    left: 0.25rem;
    border-top: 1px solid;
    border-left: 1px solid;
  }

  .map-window::after {
    right: 0.25rem;
    bottom: 0.25rem;
    border-right: 1px solid;
    border-bottom: 1px solid;
  }

  .map-window img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgb(215 193 141 / 34%);
    filter: saturate(0.86) contrast(1.03);
  }

  .map-window-label {
    position: absolute;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    left: clamp(1rem, 3vw, 2rem);
    display: grid;
    padding: 0.8rem 1rem;
    border: 1px solid rgb(197 138 54 / 60%);
    background: rgb(3 9 15 / 88%);
    backdrop-filter: blur(8px);
    gap: 0.15rem;
  }

  .map-window-label small,
  .map-window-label em {
    color: var(--archive-muted);
    font-size: 0.62rem;
    font-style: normal;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .map-window-label strong {
    font-size: clamp(1rem, 2.4vw, 1.35rem);
    font-weight: 400;
  }

  .map-window-label em {
    position: absolute;
    right: 1rem;
    bottom: 0.95rem;
    color: var(--archive-blue);
  }

  .discovery-section {
    margin-top: clamp(5rem, 10vw, 9rem);
    scroll-margin-top: 7.5rem;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--archive-line);
    gap: 2rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 400;
  }

  .section-heading > p {
    max-width: 29rem;
    margin: 0;
    color: var(--archive-muted);
    line-height: 1.6;
  }

  .route-layout {
    display: grid;
    grid-template-columns: minmax(16rem, 0.62fr) minmax(0, 1.38fr);
    margin-top: 1.5rem;
    gap: 1rem;
  }

  .curator-card {
    position: sticky;
    top: 1rem;
    align-self: start;
    padding: clamp(1.5rem, 3vw, 2.3rem);
    border: 1px solid rgb(197 138 54 / 48%);
    color: #322719;
    background:
      linear-gradient(rgb(255 255 255 / 12%), transparent),
      #cbb887;
    box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 25%);
    transform: rotate(-0.25deg);
  }

  .curator-card::after {
    position: absolute;
    right: 1.2rem;
    bottom: 1.1rem;
    width: 3.8rem;
    height: 3.8rem;
    border: 2px double rgb(96 56 20 / 45%);
    border-radius: 50%;
    content: "AH";
    display: grid;
    place-items: center;
    color: rgb(96 56 20 / 52%);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    transform: rotate(-9deg);
  }

  .curator-card .archive-kicker {
    color: #70491f;
  }

  .curator-card blockquote {
    margin: 2rem 0 1.5rem;
    font-size: clamp(1.3rem, 2.8vw, 1.9rem);
    line-height: 1.35;
  }

  .curator-card > p:last-child {
    max-width: 24rem;
    margin: 0;
    padding-right: 2.5rem;
    font-family: Arial, sans-serif;
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .route-list {
    padding: 0;
    margin: 0;
    counter-reset: route;
    list-style: none;
  }

  .route-list li + li {
    margin-top: 0.55rem;
  }

  .route-list a {
    position: relative;
    display: grid;
    align-items: center;
    grid-template-columns: 3.5rem minmax(0, 1fr) 2rem;
    min-height: 6.5rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--archive-line);
    color: var(--archive-paper);
    background:
      linear-gradient(90deg, rgb(197 138 54 / 8%), transparent 45%),
      var(--archive-panel);
    text-decoration: none;
    gap: 1rem;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      transform 160ms ease;
  }

  .route-list a::before {
    position: absolute;
    top: 1rem;
    bottom: 1rem;
    left: 0;
    width: 0.24rem;
    background: linear-gradient(#6c3e17, #d19a45 52%, #6c3e17);
    content: "";
    opacity: 0.72;
  }

  .route-list a:hover,
  .route-list a:focus-visible {
    border-color: var(--archive-brass);
    background-color: rgb(18 32 40 / 96%);
    transform: translateX(0.25rem);
  }

  .route-number {
    color: var(--archive-brass);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
  }

  .route-copy {
    display: grid;
    gap: 0.2rem;
  }

  .route-copy small {
    color: var(--archive-blue);
    font-family: Arial, sans-serif;
    font-size: 0.6rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .route-copy strong {
    font-size: 1.2rem;
    font-weight: 400;
  }

  .route-copy > span {
    color: var(--archive-muted);
    font-family: Arial, sans-serif;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .route-arrow {
    color: var(--archive-brass);
    font-size: 1.2rem;
  }

  .catalog-controls {
    display: grid;
    align-items: end;
    grid-template-columns: minmax(15rem, 1fr) minmax(20rem, 1.4fr) auto;
    padding: 1rem;
    border: 1px solid var(--archive-line);
    border-top: 0;
    background: rgb(4 12 19 / 68%);
    backdrop-filter: blur(12px);
    gap: 1rem;
  }

  .catalog-controls label {
    display: grid;
    color: var(--archive-muted);
    font-family: Arial, sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    gap: 0.45rem;
  }

  .catalog-controls input {
    width: 100%;
    min-height: 2.7rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid rgb(197 138 54 / 42%);
    border-radius: 0;
    outline: 0;
    color: var(--archive-paper);
    background: #030a10;
    font: inherit;
    letter-spacing: normal;
    text-transform: none;
  }

  .catalog-controls input:focus {
    border-color: var(--archive-blue);
    box-shadow: 0 0 0 3px rgb(89 196 222 / 14%);
  }

  .catalog-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .catalog-filters button {
    min-height: 2.7rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--archive-line);
    color: var(--archive-muted);
    background: transparent;
    cursor: pointer;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .catalog-filters button[aria-pressed="true"] {
    border-color: var(--archive-brass);
    color: var(--archive-paper);
    background: rgb(197 138 54 / 13%);
  }

  #catalog-result-count {
    padding-bottom: 0.75rem;
    color: var(--archive-blue);
    font-family: Arial, sans-serif;
    font-size: 0.68rem;
    white-space: nowrap;
  }

  .catalog-empty {
    padding: 2rem;
    border: 1px dashed var(--archive-line);
    color: var(--archive-muted);
    text-align: center;
  }

  [hidden] {
    display: none !important;
  }

  .record-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 1.5rem;
    gap: 1rem;
  }

  .record-card {
    position: relative;
    display: flex;
    overflow: hidden;
    min-height: 21rem;
    padding: 1.35rem;
    border: 1px solid var(--archive-line);
    background:
      linear-gradient(135deg, rgb(197 138 54 / 7%), transparent 45%),
      var(--archive-panel);
    flex-direction: column;
  }

  .record-card::before {
    position: absolute;
    top: 0;
    right: 1.25rem;
    left: 1.25rem;
    height: 0.24rem;
    background: linear-gradient(90deg, transparent, #b87a2d, #e0b568, #b87a2d, transparent);
    content: "";
    opacity: 0.74;
  }

  .record-code {
    display: flex;
    justify-content: space-between;
    color: var(--archive-brass);
    font-size: 0.62rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    gap: 1rem;
  }

  .record-card h3 {
    margin: 1.5rem 0 0.8rem;
    font-size: 1.4rem;
    font-weight: 400;
  }

  .record-card p {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: #b8ced4;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
  }

  .record-card a {
    margin-top: auto;
    padding-top: 1.3rem;
    color: var(--archive-paper);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-decoration-color: rgb(197 138 54 / 55%);
    text-underline-offset: 0.28rem;
    text-transform: uppercase;
  }

  .sealed-state .archive-button {
    margin-top: 2rem;
  }

  @media (max-width: 68rem) {
    .entrance-hero {
      grid-template-columns: 1fr;
      min-height: 0;
      padding: clamp(4rem, 12vw, 7rem) 0 2rem;
    }

    .map-window {
      max-width: 54rem;
    }

    .record-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .route-layout {
      grid-template-columns: 1fr;
    }

    .curator-card {
      position: relative;
      top: auto;
    }

    .catalog-controls {
      grid-template-columns: 1fr;
    }

    #catalog-result-count {
      padding-bottom: 0;
    }
  }

  @media (max-width: 44rem) {
    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .record-grid {
      grid-template-columns: 1fr;
    }

    .record-card {
      min-height: 0;
    }

    .route-list a {
      grid-template-columns: 2.5rem minmax(0, 1fr) 1rem;
      gap: 0.55rem;
    }

    .catalog-filters button {
      flex: 1 1 7rem;
    }

    .map-window-label em {
      position: static;
      margin-top: 0.35rem;
    }
  }
</style>
