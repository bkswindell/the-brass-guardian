---
import ArchiveLayout from "../../../layouts/ArchiveLayout.astro";
import { getWorldEntrancePreview } from "../../../lib/archive-preview.mjs";

const archive = getWorldEntrancePreview();
const mapEntries = archive.entries.filter((entry) => entry.mapMarker);
const initialEntry = mapEntries[0];
const description =
  "Explore the proposal preview of the illustrated Map of Aetherhaven and its first cleared archive records.";
const entryHref = (entry) =>
  `/archive/${entry.entityType}/${entry.slug}/`;
---

<ArchiveLayout title="Map of Aetherhaven" description={description} section="Public Cartography Division">
  {
    archive.enabled ? (
      <>
        <aside class="proposal-notice" aria-label="Proposal preview notice">
          <span class="proposal-dot" aria-hidden="true"></span>
          <span>
            <strong>Proposal preview.</strong> Five map records are active for design
            review. Every other numbered or restricted location remains sealed.
          </span>
        </aside>

        <header class="map-heading">
          <div>
            <p class="archive-kicker">Aetherhaven Archives • Cartographic plate 01</p>
            <h1 class="archive-title">Map of Aetherhaven</h1>
          </div>
          <p class="archive-lede">
            Twenty-four points of interest and six restricted areas appear on this
            city chart. Select a glowing marker to inspect one of the records
            currently cleared for preview.
          </p>
        </header>

        <section class="map-workbench" aria-labelledby="map-workbench-title">
          <h2 id="map-workbench-title" class="visually-hidden">Interactive map workbench</h2>

          <div class="map-toolbar" aria-label="Map controls">
            <span>Map controls</span>
            <div>
              <button id="map-zoom-out" type="button" aria-label="Zoom out">−</button>
              <output id="map-zoom-level" for="map-zoom-in map-zoom-out">100%</output>
              <button id="map-zoom-in" type="button" aria-label="Zoom in">+</button>
              <button id="map-reset" class="reset-control" type="button">Reset view</button>
            </div>
          </div>

          <div class="map-grid">
            <div id="map-viewport" class="map-viewport" tabindex="0" aria-label="Scrollable illustrated map">
              <div id="map-canvas" class="map-canvas">
                <picture>
                  <source
                    srcset="/images/archive/map-of-aetherhaven-768.webp 768w, /images/archive/map-of-aetherhaven-1152.webp 1152w, /images/archive/map-of-aetherhaven-1539.webp 1539w"
                    sizes="(max-width: 70rem) 96vw, 68rem"
                    type="image/webp"
                  />
                  <img
                    src="/images/archive/map-of-aetherhaven-1539.webp"
                    alt="Illustrated map of Aetherhaven showing a circular brass-and-canal city with twenty-four numbered points of interest, six lettered restricted areas, airship routes, rail lines, bridges, waterways, and surrounding mountains."
                    width="1539"
                    height="1152"
                    decoding="async"
                    fetchpriority="high"
                  />
                </picture>

                <div class="map-hotspots" aria-label="Cleared map markers">
                  {mapEntries.map((entry) => (
                    <button
                      class="map-hotspot"
                      type="button"
                      style={`--marker-x:${entry.mapPosition.x}%;--marker-y:${entry.mapPosition.y}%`}
                      data-map-marker={entry.mapMarker}
                      data-title={entry.publicTitle}
                      data-summary={entry.publicSummary}
                      data-classification={entry.spoilerClassification}
                      data-href={entryHref(entry)}
                      aria-label={`Map ${entry.mapMarker}: ${entry.publicTitle}`}
                      aria-controls="map-record-detail"
                    >
                      <span>{entry.mapMarker}</span>
                    </button>
                  ))}
                </div>
              </div>
            </div>

            <aside id="map-record-detail" class="map-record-detail" aria-live="polite">
              <p class="detail-code">
                <span id="detail-marker">Map {initialEntry.mapMarker}</span>
                <span id="detail-classification">{initialEntry.spoilerClassification}</span>
              </p>
              <h2 id="detail-title">{initialEntry.publicTitle}</h2>
              <p id="detail-summary">{initialEntry.publicSummary}</p>
              <a id="detail-link" class="archive-button" href={entryHref(initialEntry)}>
                Open proposal record
              </a>
              <p class="sealed-note">
                Unlit locations remain catalogued but sealed during this preview.
              </p>
            </aside>
          </div>
        </section>

        <section class="accessible-records" aria-labelledby="accessible-records-title">
          <header>
            <p class="archive-kicker">Text alternative</p>
            <h2 id="accessible-records-title">Accessible map records</h2>
          </header>
          <ol>
            {mapEntries.map((entry) => (
              <li>
                <a href={entryHref(entry)}>
                  <span>Map {entry.mapMarker}</span>
                  <strong>{entry.publicTitle}</strong>
                  <em>{entry.spoilerClassification}</em>
                </a>
              </li>
            ))}
          </ol>
        </section>

        <script>
          const viewport = document.querySelector<HTMLElement>("#map-viewport");
          const canvas = document.querySelector<HTMLElement>("#map-canvas");
          const zoomOutput = document.querySelector<HTMLOutputElement>("#map-zoom-level");
          const zoomIn = document.querySelector<HTMLButtonElement>("#map-zoom-in");
          const zoomOut = document.querySelector<HTMLButtonElement>("#map-zoom-out");
          const reset = document.querySelector<HTMLButtonElement>("#map-reset");
          const detailMarker = document.querySelector<HTMLElement>("#detail-marker");
          const detailClassification = document.querySelector<HTMLElement>("#detail-classification");
          const detailTitle = document.querySelector<HTMLElement>("#detail-title");
          const detailSummary = document.querySelector<HTMLElement>("#detail-summary");
          const detailLink = document.querySelector<HTMLAnchorElement>("#detail-link");
          const hotspots = document.querySelectorAll<HTMLButtonElement>(".map-hotspot");
          const levels = [1, 1.25, 1.5, 1.75, 2];
          let levelIndex = 0;

          const updateZoom = () => {
            const scale = levels[levelIndex];
            if (canvas) canvas.style.width = `${scale * 100}%`;
            if (zoomOutput) zoomOutput.value = `${Math.round(scale * 100)}%`;
            if (zoomOut) zoomOut.disabled = levelIndex === 0;
            if (zoomIn) zoomIn.disabled = levelIndex === levels.length - 1;
          };

          const selectHotspot = (hotspot: HTMLButtonElement) => {
            hotspots.forEach((item) => item.removeAttribute("aria-current"));
            hotspot.setAttribute("aria-current", "true");
            if (detailMarker) detailMarker.textContent = `Map ${hotspot.dataset.mapMarker}`;
            if (detailClassification) {
              detailClassification.textContent = hotspot.dataset.classification ?? "";
            }
            if (detailTitle) detailTitle.textContent = hotspot.dataset.title ?? "";
            if (detailSummary) detailSummary.textContent = hotspot.dataset.summary ?? "";
            if (detailLink) detailLink.href = hotspot.dataset.href ?? "/archive/";
          };

          zoomIn?.addEventListener("click", () => {
            levelIndex = Math.min(levels.length - 1, levelIndex + 1);
            updateZoom();
          });

          zoomOut?.addEventListener("click", () => {
            levelIndex = Math.max(0, levelIndex - 1);
            updateZoom();
          });

          reset?.addEventListener("click", () => {
            levelIndex = 0;
            updateZoom();
            viewport?.scrollTo({ top: 0, left: 0, behavior: "smooth" });
          });

          hotspots.forEach((hotspot) => {
            hotspot.addEventListener("click", () => selectHotspot(hotspot));
          });

          if (hotspots[0]) selectHotspot(hotspots[0]);
          updateZoom();
        </script>
      </>
    ) : (
      <section class="sealed-state">
        <p class="archive-kicker">Cartographic plate sealed</p>
        <h1 class="archive-title">Map unavailable</h1>
        <p class="archive-lede">This map is enabled only in an authorized branch preview.</p>
        <a class="archive-button" href="/">Return to the main exhibit</a>
      </section>
    )
  }
</ArchiveLayout>

<style>
  .visually-hidden {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    padding: 0;
    border: 0;
    margin: -1px;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .map-heading {
    display: grid;
    align-items: end;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.72fr);
    gap: clamp(2rem, 6vw, 6rem);
  }

  .map-heading .archive-title {
    max-width: 10ch;
  }

  .map-heading .archive-lede {
    margin: 0;
  }

  .map-workbench {
    margin-top: clamp(2rem, 5vw, 4rem);
    border: 1px solid var(--archive-line);
    background: rgb(2 8 13 / 88%);
    box-shadow: 0 2rem 6rem rgb(0 0 0 / 40%);
  }

  .map-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.5rem;
    padding: 0.5rem 0.7rem 0.5rem 1rem;
    border-bottom: 1px solid var(--archive-line);
    color: var(--archive-muted);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    gap: 1rem;
  }

  .map-toolbar > div {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .map-toolbar button {
    display: grid;
    min-width: 2.35rem;
    min-height: 2.35rem;
    border: 1px solid var(--archive-line);
    color: var(--archive-ink);
    background: rgb(197 138 54 / 8%);
    font: inherit;
    font-size: 1rem;
    place-items: center;
    cursor: pointer;
  }

  .map-toolbar button:hover:not(:disabled) {
    border-color: var(--archive-brass);
    background: rgb(197 138 54 / 18%);
  }

  .map-toolbar button:disabled {
    cursor: not-allowed;
    opacity: 0.35;
  }

  .map-toolbar .reset-control {
    width: auto;
    padding: 0.55rem 0.75rem;
    font-size: 0.62rem;
  }

  .map-toolbar output {
    min-width: 3.5rem;
    text-align: center;
  }

  .map-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(17rem, 22rem);
  }

  .map-viewport {
    overflow: auto;
    max-height: min(72vh, 54rem);
    background: #100e0a;
    scrollbar-color: var(--archive-brass) #08121b;
  }

  .map-canvas {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  .map-canvas picture,
  .map-canvas img {
    display: block;
    width: 100%;
    height: auto;
  }

  .map-canvas img {
    filter: saturate(0.9) contrast(1.025);
  }

  .map-hotspots {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .map-hotspot {
    position: absolute;
    top: var(--marker-y);
    left: var(--marker-x);
    display: grid;
    width: clamp(1.7rem, 3.3vw, 2.55rem);
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid #edbe68;
    border-radius: 50%;
    color: #fff3cb;
    background: rgb(3 14 22 / 86%);
    box-shadow:
      0 0 0 5px rgb(101 199 228 / 11%),
      0 0 1.2rem rgb(101 199 228 / 68%);
    font: inherit;
    font-size: clamp(0.65rem, 1.4vw, 0.86rem);
    font-weight: 700;
    place-items: center;
    transform: translate(-50%, -50%);
    pointer-events: auto;
    cursor: pointer;
  }

  .map-hotspot:hover,
  .map-hotspot[aria-current="true"] {
    color: #07111b;
    background: #f0c36e;
    box-shadow:
      0 0 0 6px rgb(101 199 228 / 20%),
      0 0 1.7rem rgb(101 199 228 / 90%);
  }

  .map-record-detail {
    display: flex;
    min-height: 26rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-left: 1px solid var(--archive-line);
    background:
      linear-gradient(145deg, rgb(197 138 54 / 9%), transparent 42%),
      var(--archive-panel);
    flex-direction: column;
  }

  .detail-code {
    display: flex;
    justify-content: space-between;
    margin: 0;
    color: var(--archive-brass);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .map-record-detail h2 {
    margin: 2rem 0 1rem;
    font-size: clamp(1.6rem, 3vw, 2.45rem);
    font-weight: 400;
    line-height: 1.05;
  }

  .map-record-detail > p:not(.detail-code, .sealed-note) {
    margin: 0;
    color: #bdd1d6;
    line-height: 1.72;
  }

  .map-record-detail .archive-button {
    align-self: flex-start;
    margin-top: 1.7rem;
  }

  .sealed-note {
    margin: auto 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--archive-line);
    color: #7898a1;
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .accessible-records {
    margin-top: clamp(3.5rem, 8vw, 7rem);
  }

  .accessible-records h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 400;
  }

  .accessible-records ol {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    padding: 0;
    margin: 1.4rem 0 0;
    list-style: none;
    gap: 0.75rem;
  }

  .accessible-records a {
    display: flex;
    min-height: 9rem;
    padding: 1rem;
    border: 1px solid var(--archive-line);
    background: var(--archive-panel);
    flex-direction: column;
    text-decoration: none;
  }

  .accessible-records a:hover {
    border-color: var(--archive-brass);
  }

  .accessible-records span,
  .accessible-records em {
    color: var(--archive-muted);
    font-size: 0.62rem;
    font-style: normal;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .accessible-records strong {
    margin-top: 1rem;
    font-size: 1rem;
    font-weight: 400;
  }

  .accessible-records em {
    margin-top: auto;
    color: var(--archive-brass);
  }

  .sealed-state .archive-button {
    margin-top: 2rem;
  }

  @media (max-width: 70rem) {
    .map-grid {
      grid-template-columns: 1fr;
    }

    .map-record-detail {
      min-height: 0;
      border-top: 1px solid var(--archive-line);
      border-left: 0;
    }

    .sealed-note {
      margin-top: 2rem;
    }

    .accessible-records ol {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 48rem) {
    .map-heading {
      align-items: start;
      grid-template-columns: 1fr;
    }

    .map-heading .archive-lede {
      margin-top: 0;
    }

    .map-toolbar {
      align-items: flex-start;
      flex-direction: column;
    }

    .map-toolbar > div {
      width: 100%;
    }

    .map-toolbar .reset-control {
      margin-left: auto;
    }

    .accessible-records ol {
      grid-template-columns: 1fr;
    }

    .accessible-records a {
      min-height: 7rem;
    }
  }
</style>
