---
import ArchiveLayout from "../../../layouts/ArchiveLayout.astro";
import { getWorldEntrancePreview } from "../../../lib/archive-preview.mjs";

const archive = getWorldEntrancePreview();
const mapEntries = archive.mapEntries;
const hiddenMapEntries = archive.hiddenMapEntries;
const routeIndex = archive.curatorRoute.findIndex((step) => step.id === "map-room");
const previousStep = archive.curatorRoute[routeIndex - 1];
const nextStep = archive.curatorRoute[routeIndex + 1];
const description =
  "Explore the proposal preview of the illustrated Map of Aetherhaven and its first cleared archive records.";
const entryHref = (entry) =>
  `/archive/${entry.entityType}/${entry.slug}/`;
const mapEntryHref = (entry) =>
  entry.archiveSection === "hidden"
    ? `/archive/hidden/#map-${entry.mapMarker}`
    : entryHref(entry);
---

<ArchiveLayout title="Map of Aetherhaven" description={description} section="Public Cartography Division">
  {
    archive.enabled ? (
      <>
        <aside class="proposal-notice" aria-label="Proposal preview notice">
          <span class="proposal-dot" aria-hidden="true"></span>
          <span>
            <strong>Proposal preview.</strong> All twenty-four public map references
            now open catalog stubs. Lettered restricted sites lead to the separately
            warned Hidden Archives.
          </span>
        </aside>

        <header class="map-heading">
          <div>
            <p class="archive-kicker">Aetherhaven Archives • Cartographic plate 01</p>
            <h1 class="archive-title">Map of Aetherhaven</h1>
          </div>
          <p class="archive-lede">
            Select a named region or its label directly on the chart. Numbered
            locations open public catalog stubs; A–F cross the marked threshold into
            spoiler-sensitive Hidden Archives.
          </p>
        </header>

        <section class="map-workbench" aria-labelledby="map-workbench-title">
          <h2 id="map-workbench-title" class="visually-hidden">Interactive map workbench</h2>

          <div class="map-toolbar" aria-label="Map controls">
            <span>Map controls</span>
            <div>
              <button id="map-zoom-out" type="button" aria-label="Zoom out">−</button>
              <output
                id="map-zoom-level"
                for="map-zoom-in map-zoom-out"
                aria-live="polite"
                aria-atomic="true">100%</output
              >
              <button id="map-zoom-in" type="button" aria-label="Zoom in">+</button>
              <button id="map-reset" class="reset-control" type="button">Reset view</button>
            </div>
          </div>

          <p class="map-instruction" id="map-instruction">
            Every outlined label and surrounding district is one link. Use Tab to
            move through the chart, or use the complete text index below. On smaller
            screens, swipe to move across the chart.
          </p>

          <div
            id="map-viewport"
            class="map-viewport"
            tabindex="0"
            aria-label="Scrollable illustrated map with linked regions"
            aria-describedby="map-instruction"
          >
            <div id="map-canvas" class="map-canvas">
              <picture>
                <source
                  srcset="/images/archive/map-of-aetherhaven-768.webp 768w, /images/archive/map-of-aetherhaven-1152.webp 1152w, /images/archive/map-of-aetherhaven-1539.webp 1539w"
                  sizes="(max-width: 92rem) 96vw, 88rem"
                  type="image/webp"
                />
                <img
                  src="/images/archive/map-of-aetherhaven-1539.webp"
                  alt="Illustrated map of Aetherhaven showing a circular brass-and-canal city with twenty-four numbered points of interest, six lettered restricted areas, airship routes, rail lines, bridges, waterways, and surrounding mountains."
                  width="1539"
                  height="1152"
                  decoding="async"
                  fetchpriority="high"
                />
              </picture>

              <svg
                class="map-link-overlay"
                viewBox="0 0 1539 1152"
                role="group"
                aria-label="Linked Aetherhaven map regions and labels"
                preserveAspectRatio="xMidYMid meet"
              >
                {
                  mapEntries.map((entry) => (
                    <a
                      href={mapEntryHref(entry)}
                      aria-label={`Map ${entry.mapMarker}: ${entry.publicTitle}`}
                      data-map-marker={entry.mapMarker}
                    >
                      <title>{`Map ${entry.mapMarker}: ${entry.publicTitle}`}</title>
                      <circle
                        class="map-region-target"
                        cx={entry.mapRegion.cx}
                        cy={entry.mapRegion.cy}
                        r={entry.mapRegion.r}
                      />
                      <rect
                        class="map-label-target"
                        x={entry.mapLabel.x}
                        y={entry.mapLabel.y}
                        width={entry.mapLabel.width}
                        height={entry.mapLabel.height}
                        rx="8"
                      />
                    </a>
                  ))
                }
                {
                  hiddenMapEntries.map((entry) => (
                    <a
                      class="restricted-map-link"
                      href={mapEntryHref(entry)}
                      aria-label={`Restricted map ${entry.mapMarker}: ${entry.publicTitle}; opens Hidden Archives`}
                      data-map-marker={entry.mapMarker}
                    >
                      <title>{`Restricted map ${entry.mapMarker}: ${entry.publicTitle}`}</title>
                      <circle
                        class="map-region-target"
                        cx={entry.mapRegion.cx}
                        cy={entry.mapRegion.cy}
                        r={entry.mapRegion.r}
                      />
                      <rect
                        class="map-label-target"
                        x={entry.mapLabel.x}
                        y={entry.mapLabel.y}
                        width={entry.mapLabel.width}
                        height={entry.mapLabel.height}
                        rx="8"
                      />
                    </a>
                  ))
                }
              </svg>
            </div>
          </div>
        </section>

        <nav class="map-route-nav" aria-label="Curator’s Route">
          <a href={previousStep.href}>
            <small>Previous stop</small>
            <strong>{previousStep.title}</strong>
          </a>
          <div>
            <span>Stop {routeIndex + 1} of {archive.curatorRoute.length}</span>
            <a href="/archive/#open-catalog">Leave the route and browse freely</a>
          </div>
          <a class="next" href={nextStep.href}>
            <small>Continue to {nextStep.title}</small>
            <strong>{nextStep.note}</strong>
          </a>
        </nav>

        <section class="accessible-records" aria-labelledby="accessible-records-title">
          <header>
            <p class="archive-kicker">Text alternative</p>
            <h2 id="accessible-records-title">Accessible map index</h2>
          </header>
          <div class="map-index-columns">
            <section aria-labelledby="public-map-index-title">
              <h3 id="public-map-index-title">Public locations • 1–24</h3>
              <ol>
                {mapEntries.map((entry) => (
                  <li>
                    <a href={entryHref(entry)}>
                      <span>Map {entry.mapMarker}</span>
                      <strong>{entry.publicTitle}</strong>
                      <em>Public stub</em>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
            <section class="restricted-index" aria-labelledby="restricted-map-index-title">
              <h3 id="restricted-map-index-title">Restricted references • A–F</h3>
              <ol>
                {hiddenMapEntries.map((entry) => (
                  <li>
                    <a href={mapEntryHref(entry)}>
                      <span>Restricted {entry.mapMarker}</span>
                      <strong>{entry.publicTitle}</strong>
                      <em>Hidden Archives</em>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          </div>
        </section>

        <script>
          const viewport = document.querySelector<HTMLElement>("#map-viewport");
          const canvas = document.querySelector<HTMLElement>("#map-canvas");
          const zoomOutput = document.querySelector<HTMLOutputElement>("#map-zoom-level");
          const zoomIn = document.querySelector<HTMLButtonElement>("#map-zoom-in");
          const zoomOut = document.querySelector<HTMLButtonElement>("#map-zoom-out");
          const reset = document.querySelector<HTMLButtonElement>("#map-reset");
          const levels = [1, 1.25, 1.5, 1.75, 2];
          let levelIndex = 0;

          const updateZoom = (preserveCenter = true) => {
            const scale = levels[levelIndex];
            const centerRatioX =
              viewport && canvas && canvas.offsetWidth > 0
                ? (viewport.scrollLeft + viewport.clientWidth / 2) / canvas.offsetWidth
                : 0.5;
            const centerRatioY =
              viewport && canvas && canvas.offsetHeight > 0
                ? (viewport.scrollTop + viewport.clientHeight / 2) / canvas.offsetHeight
                : 0.5;

            if (canvas) canvas.style.width = `max(${scale * 100}%, ${scale * 48}rem)`;
            if (zoomOutput) zoomOutput.value = `${Math.round(scale * 100)}%`;
            if (zoomOut) zoomOut.disabled = levelIndex === 0;
            if (zoomIn) zoomIn.disabled = levelIndex === levels.length - 1;

            if (preserveCenter && viewport && canvas) {
              viewport.scrollTo({
                left: centerRatioX * canvas.offsetWidth - viewport.clientWidth / 2,
                top: centerRatioY * canvas.offsetHeight - viewport.clientHeight / 2,
              });
            }
          };

          zoomIn?.addEventListener("click", () => {
            levelIndex = Math.min(levels.length - 1, levelIndex + 1);
            updateZoom();
          });

          zoomOut?.addEventListener("click", () => {
            levelIndex = Math.max(0, levelIndex - 1);
            updateZoom();
          });

          reset?.addEventListener("click", () => {
            levelIndex = 0;
            updateZoom(false);
            const behavior = window.matchMedia("(prefers-reduced-motion: reduce)").matches
              ? "auto"
              : "smooth";
            viewport?.scrollTo({ top: 0, left: 0, behavior });
          });
          updateZoom(false);
        </script>
      </>
    ) : (
      <section class="sealed-state">
        <p class="archive-kicker">Cartographic plate sealed</p>
        <h1 class="archive-title">Map unavailable</h1>
        <p class="archive-lede">This map is enabled only in an authorized branch preview.</p>
        <a class="archive-button" href="/">Return to the main exhibit</a>
      </section>
    )
  }
</ArchiveLayout>

<style>
  .visually-hidden {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    padding: 0;
    border: 0;
    margin: -1px;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .map-heading {
    display: grid;
    align-items: end;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.72fr);
    gap: clamp(2rem, 6vw, 6rem);
  }

  .map-heading .archive-title {
    max-width: 10ch;
  }

  .map-heading .archive-lede {
    margin: 0;
  }

  .map-workbench {
    margin-top: clamp(2rem, 5vw, 4rem);
    border: 1px solid var(--archive-line);
    background: rgb(2 8 13 / 88%);
    box-shadow: 0 2rem 6rem rgb(0 0 0 / 40%);
  }

  .map-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.5rem;
    padding: 0.5rem 0.7rem 0.5rem 1rem;
    border-bottom: 1px solid var(--archive-line);
    color: var(--archive-muted);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    gap: 1rem;
  }

  .map-toolbar > div {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .map-toolbar button {
    display: grid;
    min-width: 2.35rem;
    min-height: 2.35rem;
    border: 1px solid var(--archive-line);
    color: var(--archive-ink);
    background: rgb(197 138 54 / 8%);
    font: inherit;
    font-size: 1rem;
    place-items: center;
    cursor: pointer;
  }

  .map-toolbar button:hover:not(:disabled) {
    border-color: var(--archive-brass);
    background: rgb(197 138 54 / 18%);
  }

  .map-toolbar button:disabled {
    cursor: not-allowed;
    opacity: 0.35;
  }

  .map-toolbar .reset-control {
    width: auto;
    padding: 0.55rem 0.75rem;
    font-size: 0.62rem;
  }

  .map-toolbar output {
    min-width: 3.5rem;
    text-align: center;
  }

  .map-instruction {
    margin: 0;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--archive-line);
    color: var(--archive-muted);
    background: rgb(101 199 228 / 5%);
    font-size: 0.76rem;
    line-height: 1.55;
  }

  .map-viewport {
    overflow: auto;
    max-height: min(82vh, 66rem);
    background: #100e0a;
    scrollbar-color: var(--archive-brass) #08121b;
  }

  .map-canvas {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  .map-canvas picture,
  .map-canvas img {
    display: block;
    width: 100%;
    height: auto;
  }

  .map-canvas img {
    filter: saturate(0.9) contrast(1.025);
  }

  .map-link-overlay {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .map-link-overlay a {
    cursor: pointer;
  }

  .map-region-target,
  .map-label-target {
    fill: rgb(101 199 228 / 1%);
    stroke: rgb(101 199 228 / 22%);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    transition:
      fill 150ms ease,
      stroke 150ms ease,
      stroke-width 150ms ease;
  }

  .map-label-target {
    fill: rgb(197 138 54 / 3%);
    stroke: rgb(237 190 104 / 30%);
  }

  .map-link-overlay a:hover .map-region-target,
  .map-link-overlay a:focus .map-region-target,
  .map-link-overlay a:focus-visible .map-region-target {
    fill: rgb(101 199 228 / 16%);
    stroke: #8be3f7;
    stroke-width: 4;
  }

  .map-link-overlay a:hover .map-label-target,
  .map-link-overlay a:focus .map-label-target,
  .map-link-overlay a:focus-visible .map-label-target {
    fill: rgb(5 18 28 / 48%);
    stroke: #f0c36e;
    stroke-width: 4;
  }

  .map-link-overlay a:focus {
    outline: none;
  }

  .map-link-overlay .restricted-map-link .map-region-target,
  .map-link-overlay .restricted-map-link .map-label-target {
    fill: rgb(143 79 46 / 3%);
    stroke: rgb(233 126 82 / 36%);
    stroke-dasharray: 7 5;
  }

  .map-link-overlay .restricted-map-link:hover .map-region-target,
  .map-link-overlay .restricted-map-link:focus .map-region-target,
  .map-link-overlay .restricted-map-link:hover .map-label-target,
  .map-link-overlay .restricted-map-link:focus .map-label-target {
    fill: rgb(143 79 46 / 22%);
    stroke: #f29a72;
  }

  .map-route-nav {
    display: grid;
    align-items: stretch;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    margin-top: 1rem;
    border: 1px solid var(--archive-line);
    background: rgb(4 12 19 / 82%);
  }

  .map-route-nav > a {
    display: grid;
    min-height: 7.5rem;
    padding: 1.1rem;
    color: var(--archive-paper);
    text-decoration: none;
    gap: 0.55rem;
  }

  .map-route-nav > a:hover,
  .map-route-nav > a:focus-visible {
    background: rgb(197 138 54 / 9%);
  }

  .map-route-nav small {
    color: var(--archive-brass);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .map-route-nav strong {
    color: var(--archive-muted);
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.5;
  }

  .map-route-nav > div {
    display: grid;
    min-width: 11rem;
    padding: 1rem;
    border-right: 1px solid var(--archive-line);
    border-left: 1px solid var(--archive-line);
    color: var(--archive-muted);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    place-content: center;
    text-align: center;
    text-transform: uppercase;
    gap: 0.6rem;
  }

  .map-route-nav > div a {
    color: var(--archive-blue);
  }

  .map-route-nav .next {
    text-align: right;
  }

  .accessible-records {
    margin-top: clamp(3.5rem, 8vw, 7rem);
  }

  .accessible-records h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 400;
  }

  .map-index-columns {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(17rem, 1fr);
    margin-top: 1.4rem;
    gap: 1rem;
  }

  .map-index-columns > section {
    padding: 1rem;
    border: 1px solid var(--archive-line);
    background: rgb(4 15 24 / 70%);
  }

  .map-index-columns h3 {
    margin: 0;
    color: var(--archive-paper);
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .accessible-records ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: 0;
    margin: 1.4rem 0 0;
    list-style: none;
    gap: 0.75rem;
  }

  .accessible-records a {
    display: flex;
    min-height: 9rem;
    padding: 1rem;
    border: 1px solid var(--archive-line);
    background: var(--archive-panel);
    flex-direction: column;
    text-decoration: none;
  }

  .accessible-records a:hover {
    border-color: var(--archive-brass);
  }

  .accessible-records span,
  .accessible-records em {
    color: var(--archive-muted);
    font-size: 0.62rem;
    font-style: normal;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .accessible-records strong {
    margin-top: 1rem;
    font-size: 1rem;
    font-weight: 400;
  }

  .accessible-records em {
    margin-top: auto;
    color: var(--archive-brass);
  }

  .restricted-index {
    border-color: rgb(173 80 46 / 62%) !important;
    background:
      linear-gradient(145deg, rgb(143 79 46 / 12%), transparent 45%),
      rgb(9 12 17 / 80%) !important;
  }

  .restricted-index ol {
    grid-template-columns: 1fr;
  }

  .restricted-index a {
    min-height: 7rem;
  }

  .sealed-state .archive-button {
    margin-top: 2rem;
  }

  @media (max-width: 70rem) {
    .map-index-columns {
      grid-template-columns: 1fr;
    }

    .accessible-records ol {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 48rem) {
    .map-canvas {
      min-width: 48rem;
    }

    .map-heading {
      align-items: start;
      grid-template-columns: 1fr;
    }

    .map-route-nav {
      grid-template-columns: 1fr;
    }

    .map-route-nav > div {
      border: 0;
      border-top: 1px solid var(--archive-line);
      border-bottom: 1px solid var(--archive-line);
    }

    .map-route-nav .next {
      text-align: left;
    }

    .map-heading .archive-lede {
      margin-top: 0;
    }

    .map-toolbar {
      align-items: flex-start;
      flex-direction: column;
    }

    .map-toolbar > div {
      width: 100%;
    }

    .map-toolbar .reset-control {
      margin-left: auto;
    }

    .accessible-records ol {
      grid-template-columns: 1fr;
    }

    .accessible-records a {
      min-height: 7rem;
    }
  }
</style>
