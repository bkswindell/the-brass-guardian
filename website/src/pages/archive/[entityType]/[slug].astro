---
import ArchiveLayout from "../../../layouts/ArchiveLayout.astro";
import { getArchivePublication } from "../../../lib/archive-publication.mjs";

export async function getStaticPaths() {
  const archive = await getArchivePublication();
  return archive.entries.map((entry) => ({
    params: { entityType: entry.entityType, slug: entry.slug },
    props: {
      entry,
      entries: archive.entries,
      curatorRoute: archive.curatorRoute,
      isPublic: archive.isPublic,
    },
  }));
}

const { entry, entries, curatorRoute, isPublic } = Astro.props;
const relatedEntries = entry.relatedEntryIds
  .map((id) => entries.find((candidate) => candidate.id === id))
  .filter(Boolean);
const routeIndex = curatorRoute.findIndex((step) => step.id === entry.id);
const previousStep = routeIndex > 0 ? curatorRoute[routeIndex - 1] : null;
const nextStep =
  routeIndex >= 0 && routeIndex < curatorRoute.length - 1
    ? curatorRoute[routeIndex + 1]
    : null;
const description = entry.publicSummary;
const entryHref = (related) =>
  `/archive/${related.entityType}/${related.slug}/`;
const responsiveSrcset = entry.image?.sources?.length
  ? entry.image.sources.map((source) => `${source.src} ${source.width}w`).join(", ")
  : undefined;
---

<ArchiveLayout
  title={entry.publicTitle}
  description={description}
  section={isPublic ? "Public Record Viewer" : "Proposal Record Viewer"}
>
  {!isPublic && (
    <aside class="proposal-notice" aria-label="Proposal preview notice">
      <span class="proposal-dot" aria-hidden="true"></span>
      <span>
        <strong>Proposal preview.</strong> This record has not been approved as
        canonical public copy and is visible only for branch refinement.
      </span>
    </aside>
  )}

  <nav class="record-breadcrumb" aria-label="Breadcrumb">
    <a href="/archive/">Archive entrance</a>
    <span aria-hidden="true">/</span>
    <a href="/archive/map/">City map</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{entry.publicTitle}</span>
  </nav>

  <article class:list={["record-sheet", { "has-image": entry.image }]}> 
    <header class="record-header">
      <p class="record-accession">
        <span>{entry.entityType}</span>
        {entry.mapMarker && <span>Map {entry.mapMarker}</span>}
        <span>{entry.publicAccessLabel ?? entry.spoilerClassification}</span>
      </p>
      <p class="archive-kicker">
        Aetherhaven Archives • {isPublic ? "Public record" : "Proposal record"}
      </p>
      <h1 class="archive-title">{entry.publicTitle}</h1>
      <p class="canonical-name">Canonical subject: {entry.canonicalName}</p>
    </header>

    {
      entry.image && (
        <figure class:list={["record-image", `image-${entry.slug}`]}>
          <picture>
            {responsiveSrcset && (
              <source
                srcset={responsiveSrcset}
                sizes="(max-width: 66rem) 92vw, 39rem"
                type="image/webp"
              />
            )}
            <img
              src={entry.image.src}
              alt={entry.image.alt}
              width={entry.image.width}
              height={entry.image.height}
              decoding="async"
            />
          </picture>
          <figcaption>{isPublic ? "Public Archive image" : "Candidate public image • Proposal preview"}</figcaption>
        </figure>
      )
    }

    <section class="record-copy" aria-labelledby="summary-title">
      <p class="archive-kicker">{isPublic ? "Public summary" : "Public summary proposal"}</p>
      <h2 id="summary-title">Record extract</h2>
      <p>{entry.publicSummary}</p>

      <dl class="record-tags">
        <div>
          <dt>Access</dt>
          <dd>{entry.publicAccessLabel ?? entry.spoilerClassification}</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd>{isPublic ? "published" : entry.previewStatus}</dd>
        </div>
        <div>
          <dt>Tags</dt>
          <dd>{entry.tags.join(" • ")}</dd>
        </div>
      </dl>
    </section>
  </article>

  {
    routeIndex >= 0 ? (
      <nav class="curator-route-nav" aria-label="Curator’s Route">
        <header>
          <p class="archive-kicker">Suggested passage</p>
          <p>
            Stop {routeIndex + 1} of {curatorRoute.length} on the Curator’s Route
          </p>
        </header>
        <div>
          {
            previousStep ? (
              <a class="route-direction previous" href={previousStep.href}>
                <small>Previous stop</small>
                <strong>{previousStep.title}</strong>
              </a>
            ) : (
              <a class="route-direction previous" href="/archive/#curators-route">
                <small>Route index</small>
                <strong>View all eight stops</strong>
              </a>
            )
          }
          <a class="leave-route" href="/archive/#open-catalog">
            Leave the route and browse freely
          </a>
          {
            nextStep ? (
              <a class="route-direction next" href={nextStep.href}>
                <small>Next stop: {nextStep.title}</small>
                <strong>{nextStep.note}</strong>
              </a>
            ) : (
              <a class="route-direction next" href="/archive/#open-catalog">
                <small>Route complete</small>
                <strong>Continue through the Open Catalog</strong>
              </a>
            )
          }
        </div>
      </nav>
    ) : (
      <nav class="catalog-record-nav" aria-label="Catalog record navigation">
        <a href="/archive/#open-catalog">Return to the Open Catalog</a>
        {entry.mapMarker && <a href="/archive/map/">Return to the Map Room</a>}
      </nav>
    )
  }

  {
    relatedEntries.length > 0 && (
      <section class="related-records" aria-labelledby="related-title">
        <p class="archive-kicker">Cross-references</p>
        <h2 id="related-title">{isPublic ? "Related records" : "Related preview records"}</h2>
        <div>
          {relatedEntries.map((related) => (
            <a href={entryHref(related)}>
              <small>{related.entityType}</small>
              <strong>{related.publicTitle}</strong>
              <span aria-hidden="true">Open →</span>
            </a>
          ))}
        </div>
      </section>
    )
  }
</ArchiveLayout>

<style>
  .record-breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
    color: var(--archive-muted);
    font-size: 0.69rem;
    letter-spacing: 0.08em;
    gap: 0.55rem;
    text-transform: uppercase;
  }

  .record-breadcrumb a {
    text-underline-offset: 0.22rem;
  }

  .record-sheet {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.72fr);
    border: 1px solid var(--archive-line);
    background:
      linear-gradient(145deg, rgb(197 138 54 / 8%), transparent 35%),
      var(--archive-panel);
    box-shadow: 0 2rem 6rem rgb(0 0 0 / 38%);
  }

  .record-sheet:not(.has-image) .record-header {
    grid-column: 1 / -1;
  }

  .record-header {
    position: relative;
    display: flex;
    min-height: 31rem;
    padding: clamp(2rem, 6vw, 5rem);
    justify-content: center;
    flex-direction: column;
  }

  .record-header::after {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    width: 4rem;
    aspect-ratio: 1;
    border: 1px solid rgb(197 138 54 / 30%);
    border-radius: 50%;
    box-shadow: inset 0 0 0 0.4rem rgb(197 138 54 / 4%);
    content: "AH";
    color: rgb(197 138 54 / 38%);
    font-size: 0.82rem;
    line-height: 4rem;
    text-align: center;
  }

  .record-header .archive-title {
    max-width: 11ch;
  }

  .record-accession {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    left: 1.1rem;
    display: flex;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--archive-line);
    margin: 0;
    color: var(--archive-brass);
    font-size: 0.62rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    gap: 1rem;
  }

  .canonical-name {
    margin: 1.5rem 0 0;
    color: var(--archive-muted);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .record-image {
    display: grid;
    min-width: 0;
    margin: 0;
    border-left: 1px solid var(--archive-line);
    background: #02070c;
    grid-template-rows: minmax(0, 1fr) auto;
  }

  .record-image picture {
    display: grid;
    min-height: 31rem;
    place-items: center;
    overflow: hidden;
  }

  .record-image img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 44rem;
    object-fit: contain;
  }

  .record-image.image-aetherhaven picture {
    padding: 0.6rem;
  }

  .record-image figcaption {
    padding: 0.8rem 1rem;
    border-top: 1px solid var(--archive-line);
    color: var(--archive-muted);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
  }

  .record-copy {
    grid-column: 1 / -1;
    padding: clamp(2rem, 6vw, 4.5rem);
    border-top: 1px solid var(--archive-line);
  }

  .record-copy h2,
  .related-records h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 400;
  }

  .record-copy > p:not(.archive-kicker) {
    max-width: 52rem;
    margin: 1.5rem 0 0;
    color: #c5d9de;
    font-size: clamp(1.05rem, 2vw, 1.28rem);
    line-height: 1.85;
  }

  .record-tags {
    display: grid;
    grid-template-columns: 0.7fr 0.7fr 1.6fr;
    margin: 3rem 0 0;
    border-top: 1px solid var(--archive-line);
    border-left: 1px solid var(--archive-line);
  }

  .record-tags div {
    padding: 1rem;
    border-right: 1px solid var(--archive-line);
    border-bottom: 1px solid var(--archive-line);
  }

  .record-tags dt {
    color: var(--archive-brass);
    font-size: 0.6rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .record-tags dd {
    margin: 0.5rem 0 0;
    color: var(--archive-muted);
    line-height: 1.5;
    text-transform: capitalize;
  }

  .catalog-record-nav {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-top: 1rem;
    padding: 1rem;
    border: 1px solid var(--archive-line);
    background: rgb(4 12 19 / 82%);
    gap: 1rem;
  }

  .catalog-record-nav a {
    color: var(--archive-blue);
    text-underline-offset: 0.25rem;
  }

  .related-records {
    margin-top: clamp(4rem, 8vw, 7rem);
  }

  .curator-route-nav {
    margin-top: 1rem;
    border: 1px solid var(--archive-line);
    background: rgb(4 12 19 / 82%);
  }

  .curator-route-nav header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--archive-line);
    gap: 1rem;
  }

  .curator-route-nav header p {
    margin: 0;
  }

  .curator-route-nav header > p:last-child {
    color: var(--archive-muted);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .curator-route-nav > div {
    display: grid;
    align-items: stretch;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  }

  .route-direction {
    display: grid;
    min-height: 7.5rem;
    padding: 1.1rem;
    color: var(--archive-paper);
    text-decoration: none;
    gap: 0.55rem;
  }

  .route-direction:hover,
  .route-direction:focus-visible {
    background: rgb(197 138 54 / 9%);
  }

  .route-direction small {
    color: var(--archive-brass);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .route-direction strong {
    color: var(--archive-muted);
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.5;
  }

  .route-direction.next {
    border-left: 1px solid var(--archive-line);
    text-align: right;
  }

  .leave-route {
    display: grid;
    min-width: 10rem;
    padding: 1rem;
    border-left: 1px solid var(--archive-line);
    color: var(--archive-blue);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    place-items: center;
    text-align: center;
    text-transform: uppercase;
  }

  .related-records > div {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 1.5rem;
    gap: 0.75rem;
  }

  .related-records a {
    display: flex;
    min-height: 9rem;
    padding: 1rem;
    border: 1px solid var(--archive-line);
    background: var(--archive-panel);
    flex-direction: column;
    text-decoration: none;
  }

  .related-records a:hover {
    border-color: var(--archive-brass);
  }

  .related-records small,
  .related-records span {
    color: var(--archive-muted);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .related-records strong {
    margin-top: 0.8rem;
    font-size: 1.1rem;
    font-weight: 400;
  }

  .related-records span {
    margin-top: auto;
    color: var(--archive-brass);
  }

  @media (max-width: 66rem) {
    .record-sheet {
      grid-template-columns: 1fr;
    }

    .record-image {
      border-top: 1px solid var(--archive-line);
      border-left: 0;
    }

    .record-image picture {
      max-height: 48rem;
    }
  }

  @media (max-width: 48rem) {
    .record-header {
      min-height: 26rem;
    }

    .record-accession {
      flex-wrap: wrap;
    }

    .record-tags,
    .related-records > div {
      grid-template-columns: 1fr;
    }

    .record-image picture {
      min-height: 20rem;
    }

    .curator-route-nav header {
      align-items: flex-start;
      flex-direction: column;
    }

    .curator-route-nav > div {
      grid-template-columns: 1fr;
    }

    .route-direction.next,
    .leave-route {
      border-top: 1px solid var(--archive-line);
      border-left: 0;
      text-align: left;
    }
  }
</style>
