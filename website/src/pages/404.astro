---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import SiteMeta from "../components/SiteMeta.astro";

const pageTitle = "Archive Record Not Found — The Brass Guardian";
const pageDescription =
  "The requested file is not available in the public Aetherhaven Archives.";
---

<!doctype html>
<html lang="en">
  <head>
    <SiteMeta title={pageTitle} description={pageDescription} />
  </head>
  <body>
    <main>
      <section class="archive-notice" aria-labelledby="not-found-title">
        <p class="catalog-line">Aetherhaven Archives <span aria-hidden="true">•</span> Public Access</p>
        <div class="archive-mark" aria-hidden="true">AH</div>
        <p class="status">Archive index notice</p>
        <h1 id="not-found-title">Archive record not found</h1>
        <p>{pageDescription}</p>
        <a href="/">Return to the archive entrance</a>
      </section>
    </main>

    <Analytics />
    <SpeedInsights />
  </body>
</html>

<style>
  :global(:root) {
    color-scheme: dark;
    font-family: Georgia, "Times New Roman", serif;
    background: #050c16;
    color: #f3e3bb;
  }

  :global(body) {
    display: grid;
    min-height: 100vh;
    margin: 0;
    place-items: center;
    background:
      radial-gradient(circle at 50% 35%, rgb(16 76 100 / 40%), transparent 33rem),
      linear-gradient(155deg, #030914 0%, #09182a 52%, #06101d 100%);
  }

  :global(body::before) {
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgb(150 218 238 / 3%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(150 218 238 / 3%) 1px, transparent 1px);
    background-size: 4rem 4rem;
    content: "";
    mask-image: linear-gradient(to bottom, transparent, #000 30%, transparent);
    pointer-events: none;
  }

  main {
    width: min(100% - 2rem, 43rem);
    padding: 2rem 0;
  }

  .archive-notice {
    position: relative;
    padding: clamp(2rem, 7vw, 4.5rem);
    border: 1px solid rgb(182 122 38 / 70%);
    background: rgb(5 15 27 / 88%);
    box-shadow: 0 1.5rem 5rem rgb(0 0 0 / 45%);
    text-align: center;
  }

  .archive-notice::before {
    position: absolute;
    inset: 0.35rem;
    border: 1px solid rgb(216 195 143 / 18%);
    content: "";
    pointer-events: none;
  }

  .catalog-line,
  .status {
    margin: 0;
    color: #d6a34b;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .catalog-line span {
    padding: 0 0.45rem;
  }

  .archive-mark {
    display: grid;
    width: 4rem;
    aspect-ratio: 1;
    margin: 2.25rem auto 1.75rem;
    border: 1px solid #b67a26;
    border-radius: 50%;
    outline: 1px solid rgb(243 227 187 / 35%);
    outline-offset: -0.4rem;
    place-items: center;
  }

  .status {
    color: #72d6eb;
  }

  h1 {
    margin: 1rem 0;
    font-size: clamp(2.2rem, 8vw, 4rem);
    font-weight: 400;
    line-height: 1;
  }

  p:not(.catalog-line, .status) {
    max-width: 31rem;
    margin: 0 auto;
    color: #c9dfe5;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 1rem;
    line-height: 1.8;
  }

  a {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.85rem 1.1rem;
    border: 1px solid rgb(182 122 38 / 75%);
    color: #f3e3bb;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-decoration: none;
    text-transform: uppercase;
  }

  a:hover {
    background: rgb(182 122 38 / 12%);
  }

  a:focus-visible {
    outline: 2px solid #72d6eb;
    outline-offset: 4px;
  }
</style>
